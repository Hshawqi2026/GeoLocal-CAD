      <Name>GeoLocalCAD.Raster</Name>
    </ProjectReference>
    <ProjectReference Include="..\GeoLocalCAD.DEM\GeoLocalCAD.DEM.csproj">
      <Project>{C2D0B5A4-7F14-4B1C-8D21-4F0D9C6A7E33}</Project>
      <Name>GeoLocalCAD.DEM</Name>
