    <Error Condition="!Exists('$(AutodeskManagedApiPath)\AcDbMgd.dll')" Text="AutoCAD 2020 managed API not found: AcDbMgd.dll." />
    <Error Condition="!Exists('$(AutodeskManagedApiPath)\AcMgd.dll')" Text="AutoCAD 2020 managed API not found: AcMgd.dll." />
    <Error Condition="!Exists('$(AutodeskManagedApiPath)\AdWindows.dll')" Text="AutoCAD 2020 Ribbon API not found: AdWindows.dll." />
    <Error Condition="!Exists('$(Civil3DManagedApiPath)\AeccDbMgd.dll')" Text="Civil 3D 2020 managed API not found: AeccDbMgd.dll. Set Civil3DManagedApiPath to the licensed Civil 3D installation directory." />
  </Target>
</Project>
