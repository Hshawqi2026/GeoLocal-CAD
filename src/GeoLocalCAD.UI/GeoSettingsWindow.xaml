<Window x:Class="GeoLocalCAD.UI.GeoSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GeoLocal CAD Settings" Height="330" Width="560"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="GeoLocal CAD Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
        <CheckBox Grid.Row="1" x:Name="OfflineModeCheckBox" Content="Offline mode (no web map or tile API requests)" Margin="0,0,0,14" />
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Drawing CRS:" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" x:Name="DrawingCrsTextBox" Height="26" ToolTip="Enter an explicit CRS identifier, for example EPSG:32638." />
        </Grid>
        <TextBlock Grid.Row="3" x:Name="StatusTextBlock" TextWrapping="Wrap" Foreground="#555555" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button x:Name="SaveButton" Content="Save" Width="90" IsDefault="True" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
